# Porta HTTP da aplicacao e porta externa exposta para o MySQL do Compose
SERVER_PORT=8080
MYSQL_HOST_PORT=3307

# Banco de dados MySQL (valores ficticios para desenvolvimento local e Docker Compose)
MYSQL_DATABASE=eventif
MYSQL_USER=eventif_user
MYSQL_PASSWORD=eventif_dev_pass
MYSQL_ROOT_PASSWORD=eventif_root_dev_pass
SPRING_JPA_DDL_AUTO=update

# Para execucao manual fora do Docker (ajuste porta/credenciais se necessario):
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/eventif?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Fortaleza&characterEncoding=UTF-8
# SPRING_DATASOURCE_USERNAME=eventif_user
# SPRING_DATASOURCE_PASSWORD=eventif_dev_pass

# Credenciais ficticias da conta ADMIN inicial (RS07)
EVENTIF_ADMIN_NOME=Administrador EventIF
EVENTIF_ADMIN_EMAIL=admin@eventif.edu.br
EVENTIF_ADMIN_SENHA=AdminDemo@123

# Carga idempotente de dados de exemplo (RT04 - valores ficticios para demonstracao)
EVENTIF_SEED_DEMO_ENABLED=true
EVENTIF_DEMO_ORG_NOME=Prof. Carlos Organizador
EVENTIF_DEMO_ORG_EMAIL=organizador@eventif.edu.br
EVENTIF_DEMO_ORG_SENHA=OrgDemo@123
EVENTIF_DEMO_ORG2_NOME=Profa. Marina Organizadora
EVENTIF_DEMO_ORG2_EMAIL=organizador2@eventif.edu.br
EVENTIF_DEMO_ORG2_SENHA=Org2Demo@123
EVENTIF_DEMO_PART_NOME=Ana Clara Participante
EVENTIF_DEMO_PART_EMAIL=participante@eventif.edu.br
EVENTIF_DEMO_PART_SENHA=PartDemo@123
